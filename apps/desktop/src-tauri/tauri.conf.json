{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 900,
        "minHeight": 480,
        "minWidth": 390,
        "title": "ALLTP Tracker",
        "width": 1440
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm --filter @alltp/web exec vite build --mode desktop",
    "beforeDevCommand": "pnpm --filter @alltp/web exec vite --mode desktop",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist-desktop"
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Item and map tracker for randomizer runs",
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"]
  },
  "identifier": "io.github.kqesar.alltp-tracker",
  "mainBinaryName": "alltp-tracker",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kqesar/alltp-tracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBM0RFNDFGRDczMTJDOTkKUldTWkxESFhIK1E5MnJ4THluaGJ1VEIwVDBZYU5oM3FlQmV5MUprSmF1eFNpR21yNFhudVlEUXkK"
    }
  },
  "productName": "ALLTP Tracker",
  "version": "../../../package.json"
}
