{
  "name": "@alltp/pack-alttpr",
  "version": "0.0.0",
  "private": true,
  "description": "A Link to the Past Randomizer game pack: the v31 rules as data, items and upstream tests",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./spoiler": "./src/spoiler/parse.ts"
  },
  "scripts": {
    "import-dr": "node scripts/import-dr.mjs",
    "import-er": "node scripts/import-er.mjs",
    "import-item-names": "node scripts/import-item-names.mjs",
    "import-rupee-texts": "node scripts/import-rupee-texts.mjs",
    "import-upstream": "node scripts/import-upstream-tests.mjs",
    "record-dark-room": "node scripts/record-dark-room.mjs",
    "record-dr-seeds": "node scripts/record-dr-seeds.mjs",
    "record-dr-spoilers": "node scripts/record-dr-spoilers.mjs",
    "spoiler-fixtures": "node scripts/spoiler-fixtures.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@alltp/autotrack": "workspace:*",
    "@alltp/engine": "workspace:*",
    "@alltp/spoiler": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "js-yaml": "5.5.0"
  }
}
