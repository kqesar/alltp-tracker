{
  "name": "@alltp/pack-smz3",
  "version": "0.0.0",
  "private": true,
  "description": "SMZ3 game pack: samus.link's logic for both games as data, held to its upstream tests",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./spoiler": "./src/spoiler/parse.ts"
  },
  "scripts": {
    "import-upstream": "node scripts/import-upstream-tests.mjs",
    "spoiler-fixtures": "node scripts/spoiler-fixtures.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@alltp/autotrack": "workspace:*",
    "@alltp/engine": "workspace:*",
    "@alltp/spoiler": "workspace:*",
    "js-yaml": "5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alltp/pack-alttpr": "workspace:*",
    "yaml": "1.10.3"
  }
}
