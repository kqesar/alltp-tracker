{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "double"
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-desktop",
      "!**/dist_dev",
      "!**/dev-dist",
      "!**/.husky",
      "!**/build",
      "!apps/desktop/src-tauri/target",
      "!apps/desktop/src-tauri/gen",
      "!**/coverage",
      "!**/coverage_backup",
      "!**/package.json",
      "!packs/*/test/upstream",
      "!packs/smz3/src/markers-hyrule.json",
      "!packs/smz3/src/autotrack/zelda-flags.json",
      "!**/playwright-report",
      "!**/test-results",
      "!pnpm-lock.yaml",
      "!**/.git",
      "!**/.claude/settings.local.json",
      "!.claude/worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "enabled": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useKeyWithMouseEvents": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off"
      },
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  }
}
