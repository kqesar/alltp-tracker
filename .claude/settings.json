{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-check.mjs\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm exec biome check *)",
      "Bash(pnpm exec tsc -b)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm test)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm vitest run *)"
    ],
    "deny": [
      "Read(./**/*.tsbuildinfo)",
      "Read(./**/dist/**)",
      "Read(./coverage/**)"
    ]
  }
}
