{
  "name": "alltp-tracker",
  "version": "2.10.0",
  "private": true,
  "description": "A tracker for Zelda a Link to the Past Randomizer",
  "bugs": {
    "url": "https://github.com/kqesar/alltp-tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kqesar/alltp-tracker.git"
  },
  "license": "MIT",
  "author": "KqesaR",
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && pnpm --filter @alltp/web build",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "commit": "git-cz",
    "coverage": "node scripts/show-coverage.js",
    "dev": "pnpm --filter @alltp/web dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "preview": "pnpm --filter @alltp/web preview",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "sort-package": "sort-package-json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:show": "vitest run --coverage && node scripts/show-coverage.js",
    "test:e2e": "pnpm --filter @alltp/web test:e2e",
    "typecheck": "tsc -b"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "**/package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-cli": "^5.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "fast-check": "4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "sort-package-json": "^4.0.0",
    "standard-version": "^9.5.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
