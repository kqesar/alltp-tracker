{
  "compilerOptions": {
    "isolatedModules": true,
    // No DOM, no Node: the package takes strings and numbers and reaches no
    // platform API.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.src.tsbuildinfo",
    "types": [],
    "verbatimModuleSyntax": true
  },
  "exclude": ["src/**/*.spec.ts"],
  "include": ["src"]
}
